                },
                "controls": {
                  "mouseWheelZoom": true,
                  "showAttribution": true,
                  "showDebug": false,
                  "showMeasure": false,
                  "showScale": false,
                  "showZoom": true
                },
                "layers": [
                  {
                    "config": {
                      "showLegend": true,
                      "style": {
                        "color": {
                          "field": "congestion",
                          "fixed": "green"
                        },
                        "opacity": 0.9,
                        "rotation": {
                          "fixed": 0,
                          "max": 360,
                          "min": -360,
                          "mode": "mod"
                        },
                        "size": {
                          "fixed": 3,
                          "max": 15,
                          "min": 2
                        },
                        "symbol": {
                          "fixed": "img/icons/marker/circle.svg",
                          "mode": "fixed"
                        },
                        "symbolAlign": {
                          "horizontal": "center",
                          "vertical": "center"
                        },
                        "textConfig": {
                          "fontSize": 12,
                          "offsetX": 0,
                          "offsetY": 0,
                          "textAlign": "center",
                          "textBaseline": "middle"
                        }
                      }
                    },
                    "location": {
                      "latitude": "latitude",
                      "longitude": "longitude",
                      "mode": "coords"
                    },
                    "name": "Congestión",
                    "tooltip": true,
                    "type": "markers"
                  }
                ],
                "tooltip": {
                  "mode": "details"
                },
                "view": {
                  "allLayers": true,
                  "dashboardVariable": false,
                  "id": "coords",
                  "lat": 22.15,
                  "lon": -100.98,
                  "noRepeat": false,
                  "zoom": 12
                }
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 1.3,
                        "color": "yellow"
                      },
                      {
                        "value": 1.7,
                        "color": "orange"
                      },
                      {
                        "value": 2.5,
                        "color": "red"
                      },
                      {
                        "value": 9.99,
                        "color": "purple"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "custom": {
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Congestión inferida (último ciclo)",
          "description": "Congestión del último ciclo en todas las calles (medidas + inferidas por IDW), agregada en celdas de ~200 m. El calor es el exceso sobre flujo libre (congestión − 1, tope 1.5): las zonas libres no pintan (D40).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "timescaledb"
                      },
                      "spec": {
                        "dataset": "vialidades_slp",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "-- Congestión inferida del ÚLTIMO ciclo del predictor dentro del rango (trafico_calles, D13).\n-- Reemplaza la consulta a trafico_inferido (IDW_GRID, legado P10: ya no se escribe ni existe en el cluster).\n-- Un ciclo son ~67 k calles; se agregan en celdas de 0.002° (~200 m) → ~3.3 k puntos para el navegador (D33).\n-- nivel_congestion_inf: 1 = flujo libre; mayor = más congestión.\nWITH puntos AS (\n    SELECT t.timestamp_calculo,\n           t.nivel_congestion_inf,\n           ST_LineInterpolatePoint(o.geom, 0.5) AS p\n    FROM trafico_calles t\n    JOIN dim_calles_osm o ON o.osm_id = t.osm_id\n    WHERE t.timestamp_calculo = (\n        SELECT max(timestamp_calculo) FROM trafico_calles WHERE $__timeFilter(timestamp_calculo)\n    )\n)\nSELECT\n    max(timestamp_calculo)     AS \"time\",\n    avg(nivel_congestion_inf)  AS \"congestion_inferida\",\n    -- Peso del heatmap (D40): exceso sobre flujo libre, con tope para que las cerradas (10) no saturen la escala.\n    least(greatest(avg(nivel_congestion_inf) - 1, 0), 1.5) AS peso,\n    avg(ST_Y(p))               AS latitude,\n    avg(ST_X(p))               AS longitude\nFROM puntos\nGROUP BY round(ST_Y(p)::numeric / 0.002), round(ST_X(p)::numeric / 0.002);",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "geomap",
            "version": "13.0.2",
            "spec": {
              "options": {
                "basemap": {
                  "config": {},
                  "name": "Layer 0",
                  "noRepeat": false,
                  "type": "osm-standard"
                },
                "controls": {
                  "mouseWheelZoom": true,
                  "showAttribution": true,
                  "showDebug": false,
                  "showMeasure": false,
                  "showScale": false,
                  "showZoom": true
                },
                "layers": [
                  {
                    "config": {
                      "blur": 18,
                      "radius": 8,
                      "weight": {
                        "field": "peso",
                        "fixed": 1,
                        "max": 1,
                        "min": 0
                      }
                    },
                    "location": {
                      "latitude": "latitude",
                      "longitude": "longitude",
                      "mode": "coords"
                    },
                    "name": "Exceso de congestión",
                    "tooltip": true,
                    "type": "heatmap"
                  }
                ],
                "tooltip": {
                  "mode": "details"
                },
                "view": {
                  "allLayers": true,
                  "dashboardVariable": false,
                  "id": "coords",
                  "lat": 22.15,
                  "lon": -100.98,
                  "noRepeat": false,
                  "zoom": 12
                }
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "shades",
                    "fixedColor": "green"
                  },
                  "custom": {
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "peso"
                    },
                    "properties": [
                      {
                        "id": "min",
                        "value": 0
                      },
                      {
                        "id": "max",
                        "value": 1.5
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "ETL: minutos desde el último ciclo exitoso",
          "description": "kube_cronjob_status_last_successful_time del CronJob geotracker-etl (kube-state-metrics). Corre cada 15 min; > 45 min dispara la alerta \"ETL sin correr\" (D40).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "(time() - max(kube_cronjob_status_last_successful_time{namespace=\"geotracker\", cronjob=\"geotracker-etl\"})) / 60",
                        "instant": true,
                        "range": false,
                        "legendFormat": "minutos"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.2",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "textMode": "value",
                "orientation": "auto",
                "wideLayout": true,
                "showPercentChange": false
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "m",
                  "decimals": 0,
                  "color": {
                    "mode": "thresholds"
                  },
                  "noValue": "sin dato",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 20,
                        "color": "orange"
                      },
                      {
                        "value": 45,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      }
