      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "GeoMap Traffic",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "timescaledb"
                      },
                      "spec": {
                        "dataset": "vialidades_slp",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH ultima_lectura AS (\r\n    SELECT DISTINCT ON (id_segmento)\r\n        id_segmento,\r\n        timestamp_lectura,\r\n        nivel_congestion,\r\n        velocidad_actual\r\n    FROM fact_lecturas_trafico\r\n    ORDER BY id_segmento, timestamp_lectura DESC\r\n)\r\nSELECT\r\n    d.nombre_via,\r\n    u.timestamp_lectura          AS \"time\",\r\n    u.nivel_congestion           AS \"congestion\",\r\n    u.velocidad_actual,\r\n    -- Centroide real del segmento en lugar del primer punto del JSONB.\r\n    -- ST_Y/ST_X extraen lat/lon del punto central de la línea completa.\r\n    ST_Y(ST_Centroid(d.geom))    AS latitude,\r\n    ST_X(ST_Centroid(d.geom))    AS longitude\r\nFROM ultima_lectura u\r\nJOIN dim_segmentos_viales d ON u.id_segmento = d.id_segmento\r\nWHERE d.geom IS NOT NULL;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "geomap",
            "version": "13.0.2",
            "spec": {
