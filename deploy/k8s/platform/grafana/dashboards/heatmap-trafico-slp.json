                        "textConfig": {
                          "fontSize": 12,
                          "offsetX": 0,
                          "offsetY": 0,
                          "textAlign": "center",
                          "textBaseline": "middle"
                        }
                      }
                    },
                    "location": {
                      "latitude": "latitude",
                      "longitude": "longitude",
                      "mode": "coords"
                    },
                    "name": "Layer 1",
                    "tooltip": true,
                    "type": "markers"
                  }
