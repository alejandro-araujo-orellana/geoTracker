      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "HeatMap SLP Traffic",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "timescaledb"
                      },
                      "spec": {
                        "dataset": "vialidades_slp",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n    time_bucket('15 minutes', timestamp_lectura) AS \"time\",\r\n    AVG(nivel_congestion)                         AS \"congestion_promedio\"\r\nFROM fact_lecturas_trafico\r\nWHERE $__timeFilter(timestamp_lectura)\r\nGROUP BY \"time\"\r\nORDER BY \"time\" ASC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "heatmap",
            "version": "13.0.2",
            "spec": {
              "options": {
