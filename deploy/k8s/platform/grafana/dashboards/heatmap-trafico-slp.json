    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Congestión por ciclo (calles medidas)",
          "description": "Por ciclo de 15 min, sobre las calles medidas por tiles (resumen_trafico_ciclo, D38): congestión promedio (1 = flujo libre) y % de calles con congestión >= 1.3 (incluye cerradas). Los huecos son ciclos sin datos (ETL o cluster detenido).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "timescaledb"
                      },
                      "spec": {
                        "dataset": "vialidades_slp",
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "-- Serie por ciclo desde el continuous aggregate resumen_trafico_ciclo (migración 014, D38).\nSELECT\n    ciclo                                                   AS \"time\",\n    congestion_promedio                                     AS \"Congestión promedio\",\n    100.0 * aristas_congestionadas / NULLIF(aristas_medidas, 0) AS \"% calles congestionadas\"\nFROM resumen_trafico_ciclo\nWHERE $__timeFilter(ciclo)\nORDER BY 1;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.0.2",
            "spec": {
              "options": {
                "legend": {
                  "showLegend": true,
                  "displayMode": "list",
                  "placement": "bottom",
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ]
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "decimals": 2,
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "orange"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "lineWidth": 2,
                    "fillOpacity": 10,
                    "gradientMode": "none",
                    "showPoints": "never",
                    "spanNulls": false,
                    "insertNulls": 1800000,
                    "axisPlacement": "auto",
                    "axisSoftMin": 1,
                    "thresholdsStyle": {
                      "mode": "line+area"
                    }
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "transparent"
                      },
                      {
                        "value": 1.3,
                        "color": "yellow"
                      },
                      {
                        "value": 1.7,
                        "color": "orange"
                      },
                      {
                        "value": 2.5,
                        "color": "red"
                      }
                    ]
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "% calles congestionadas"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "percent"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      },
                      {
                        "id": "min",
                        "value": 0
                      },
                      {
                        "id": "custom.axisPlacement",
                        "value": "right"
                      },
                      {
                        "id": "custom.axisSoftMin",
                        "value": 0
                      },
                      {
                        "id": "custom.fillOpacity",
                        "value": 0
                      },
                      {
                        "id": "custom.lineStyle",
                        "value": {
                          "fill": "dash",
                          "dash": [
                            6,
                            4
                          ]
                        }
                      },
                      {
                        "id": "custom.thresholdsStyle",
                        "value": {
                          "mode": "off"
                        }
                      },
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "red"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Tráfico medido por calle (último ciclo)",
          "description": "Calles medidas por los vector tiles de TomTom en el último ciclo del rango (trafico_calles, metodo_inferencia = TILE). Cada calle se dibuja como puntos cada 30 m, coloreados por congestión: 1 = flujo libre; 10 = cerrada (D37).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "timescaledb"
                      },
                      "spec": {
                        "dataset": "vialidades_slp",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "-- Calles MEDIDAS por tiles (metodo_inferencia = 'TILE') en el último ciclo del rango (D37).\n-- Geomap no dibuja una línea por segmento: cada calle se densifica en puntos cada 30 m (UTM 14N),\n-- que a zoom 12-15 se ven como un trazo continuo. ~15 k calles → ~38 k puntos, ~0.3 s.\n-- Orden ascendente: las calles más congestionadas se pintan encima (las de doble sentido son dos aristas).\n-- nivel_congestion_inf: 1 = flujo libre; mayor = más congestión; 10 = cerrada.\nWITH ciclo AS (\n    SELECT max(timestamp_calculo) AS ts\n    FROM trafico_calles\n    WHERE $__timeFilter(timestamp_calculo) AND metodo_inferencia = 'TILE'\n), medidas AS (\n    SELECT t.timestamp_calculo,\n           t.nivel_congestion_inf,\n           o.nombre,\n           o.tipo_via,\n           ST_Transform(o.geom, 32614) AS g\n    FROM trafico_calles t\n    JOIN ciclo c ON t.timestamp_calculo = c.ts\n    JOIN dim_calles_osm o ON o.osm_id = t.osm_id\n    WHERE t.metodo_inferencia = 'TILE'\n)\nSELECT\n    m.timestamp_calculo                       AS \"time\",\n    round(m.nivel_congestion_inf::numeric, 2) AS congestion,\n    coalesce(m.nombre, '(sin nombre)')        AS calle,\n    m.tipo_via,\n    ST_Y(d.p)                                 AS latitude,\n    ST_X(d.p)                                 AS longitude\nFROM medidas m\nCROSS JOIN LATERAL (\n    SELECT (ST_DumpPoints(ST_Transform(\n               ST_LineInterpolatePoints(m.g, least(1.0, 30.0 / greatest(ST_Length(m.g), 30.0))),\n               4326))).geom AS p\n) d\nORDER BY congestion ASC;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "geomap",
            "version": "13.0.2",
            "spec": {
              "options": {
                "basemap": {
                  "config": {},
