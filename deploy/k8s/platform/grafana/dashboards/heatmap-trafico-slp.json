                  "fill": "dark-orange",
                  "max": 2.5,
                  "min": 1,
                  "mode": "scheme",
                  "reverse": false,
                  "scale": "exponential",
                  "scheme": "RdYlGn",
                  "steps": 64
                },
                "exemplars": {
                  "color": "rgba(255,0,255,0.7)"
                },
                "filterValues": {
                  "le": 1e-09
                },
                "legend": {
