                  "axisPlacement": "left",
                  "reverse": false
                }
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "scaleDistribution": {
                      "type": "linear"
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
