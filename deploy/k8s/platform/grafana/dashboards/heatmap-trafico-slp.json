      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Congestión inferida (último ciclo)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "timescaledb"
                      },
                      "spec": {
                        "dataset": "vialidades_slp",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "-- Congestión inferida del ÚLTIMO ciclo del predictor dentro del rango (trafico_calles, D13).\n-- Reemplaza la consulta a trafico_inferido (IDW_GRID, legado P10: ya no se escribe ni existe en el cluster).\n-- Un ciclo son ~67 k calles; se agregan en celdas de 0.002° (~200 m) → ~3.3 k puntos para el navegador (D33).\n-- nivel_congestion_inf: 1 = flujo libre; mayor = más congestión.\nWITH puntos AS (\n    SELECT t.timestamp_calculo,\n           t.nivel_congestion_inf,\n           ST_LineInterpolatePoint(o.geom, 0.5) AS p\n    FROM trafico_calles t\n    JOIN dim_calles_osm o ON o.osm_id = t.osm_id\n    WHERE t.timestamp_calculo = (\n        SELECT max(timestamp_calculo) FROM trafico_calles WHERE $__timeFilter(timestamp_calculo)\n    )\n)\nSELECT\n    max(timestamp_calculo)     AS \"time\",\n    avg(nivel_congestion_inf)  AS \"congestion_inferida\",\n    avg(ST_Y(p))               AS latitude,\n    avg(ST_X(p))               AS longitude\nFROM puntos\nGROUP BY round(ST_Y(p)::numeric / 0.002), round(ST_X(p)::numeric / 0.002);",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "geomap",
            "version": "13.0.2",
            "spec": {
              "options": {
                "basemap": {
                  "config": {},
                  "name": "Layer 0",
                  "noRepeat": false,
                  "type": "osm-standard"
                },
                "controls": {
                  "mouseWheelZoom": true,
                  "showAttribution": true,
                  "showDebug": false,
                  "showMeasure": false,
                  "showScale": false,
                  "showZoom": true
                },
                "layers": [
                  {
                    "config": {
                      "blur": 15,
                      "radius": 5,
                      "weight": {
                        "field": "congestion_inferida",
                        "fixed": 1,
                        "max": 1,
                        "min": 0
                      }
                    },
                    "location": {
                      "latitude": "latitude",
                      "longitude": "longitude",
                      "mode": "coords"
                    },
                    "name": "Layer 1",
                    "tooltip": true,
                    "type": "heatmap"
                  }
                ],
                "tooltip": {
                  "mode": "details"
                },
                "view": {
                  "allLayers": true,
                  "dashboardVariable": false,
                  "id": "coords",
                  "lat": 22.15,
                  "lon": -100.98,
                  "noRepeat": false,
                  "zoom": 12
                }
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "shades",
                    "fixedColor": "green"
                  },
                  "custom": {
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    }
                  }
                },
                "overrides": []
              }
            }
          }
        }
