# Copia a secret.env (ignorado por git) y llena los valores. Formato KEY=valor, sin comillas.
# Lo lee el secretGenerator de kustomization.yaml → Secret geotracker-secret (D27).
DB_PASSWORD=
TOMTOM_API_KEY=
# Uno o más tokens separados por coma, de >= 32 caracteres: openssl rand -hex 32 (D26)
API_TOKENS=
